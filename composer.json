{
    "name": "marekmiklusek/laravel-slack-errors",
    "description": "Send every reported exception from your Laravel app to a Slack channel.",
    "keywords": ["laravel", "slack", "errors", "exceptions", "notifications", "monitoring"],
    "license": "MIT",
    "authors": [
        {
            "name": "Marek Miklusek",
            "email": "marek.miklusek@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/console": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.32.3",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3.5",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-phpstan": "^5.3.1",
        "pestphp/pest-plugin-type-coverage": "^5.1.0",
        "rector/rector": "^2.8.4"
    },
    "autoload": { 
        "psr-4": { 
            "MarekMiklusek\\SlackErrors\\": "src/" 
        } 
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": { 
        "laravel": { 
            "providers": ["MarekMiklusek\\SlackErrors\\SlackErrorsServiceProvider"] 
        } 
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": [
            "rector",
            "pint --parallel"
        ],
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run"
        ],
        "test:unit": "pest --parallel --coverage --exactly=100.0",
        "test:types": "phpstan",
        "test": [
            "@test:type-coverage",
            "@test:unit",
            "@test:lint",
            "@test:types"
        ]
    }
}
